{
  "name": "kaipass",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node e2e/run.cjs",
    "build:ext": "tsc --noEmit && node scripts/build-ext.mjs",
