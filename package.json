    "fflate": "^0.8.3",
    "hash-wasm": "^4.13.0",
    "jsqr": "^1.4.0",
    "kdbxweb": "^2.1.1",
    "lucide-static": "^1.73.0",
    "pixelarticons": "^2.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tldts": "^7.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
