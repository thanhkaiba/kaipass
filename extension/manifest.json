{
  "manifest_version": 3,
  "name": "KaiPass",
  "description": "Trình quản lý mật khẩu cá nhân: gợi ý và tự điền mật khẩu, mã OTP; lưu file mã hoá trên Google Drive của bạn.",
  "key": "",
  "action": {
    "default_popup": "index.html?popup",
    "default_title": "KaiPass",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "identity",
    "alarms"
  ],
  "optional_permissions": [
    "privacy"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://www.googleapis.com; frame-src 'self' blob:; object-src 'none'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Mở KaiPass"
    }
  }
}
